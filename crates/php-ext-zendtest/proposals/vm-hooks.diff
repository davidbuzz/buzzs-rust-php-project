index 0000000..27b328d
--- /dev/null
+++ b/crates/php-vm/src/observer.rs
@@ -0,0 +1,249 @@
+//! The observer API (`Zend/zend_observer.c`): extensions see every call
+//! of a function (user or native), of a file (main script, `include`,
+//! `eval`) and every generator resumption. The first call of each
+//! function runs the `init` hook (`zend_observer_fcall_init`, cached per
+//! function like php-src's run-time cache slot); when it returns `true`,
+//! `begin` runs on entry and `end` on exit with the return value (`None`
+//! when the frame unwinds by an exception or a bailout; the exception is
+//! then [`Vm::current_exception`]). Calls made from inside a hook are not
+//! observed.
+
+use crate::func::{flags, Func};
+use crate::vm::{Frame, FrameKind, Throw};
+use crate::Vm;
+use php_runtime::{Obj, Value, ZStr};
+use std::collections::HashMap;
+use std::rc::Rc;
+
+/// What an observer sees of an observed frame (`zend_execute_data`).
+#[derive(Clone, Debug, Default)]
+pub struct ObservedFrame {
+    /// The function name (`func->common.function_name`); `None` for a
+    /// file (main script, include, eval).
+    pub function: Option<ZStr>,
+    /// The class scope of a method or class-bound closure
+    /// (`func->common.scope`).
+    pub scope: Option<ZStr>,
+    /// The file of a file frame (`op_array.filename`).
+    pub filename: Option<ZStr>,
+    /// Whether the function is native.
+    pub internal: bool,
+}
+
+/// Observer callbacks (`zend_observer_fcall_init` handlers and the
+/// `zend_execute_internal` override).
+#[derive(Clone, Copy, Debug, Default)]
+#[allow(clippy::type_complexity)]
+pub struct ObserverHooks {
+    /// First call of a function/file: whether to observe it (`None`:
+    /// observe nothing).
+    pub init: Option<fn(&mut Vm, &ObservedFrame) -> bool>,
+    /// Entry of an observed frame.
+    pub begin: Option<fn(&mut Vm, &ObservedFrame)>,
+    /// Exit of an observed frame (return value, or `None` on unwinding).
+    pub end: Option<fn(&mut Vm, &ObservedFrame, Option<&Value>)>,
+    /// Around every native function body (`zend_execute_internal`).
+    pub internal_enter: Option<fn(&mut Vm, &ObservedFrame)>,
+    /// After every native function body, with its result.
+    pub internal_leave: Option<fn(&mut Vm, &ObservedFrame, Option<&Value>)>,
+}
+
+/// Observer state of the VM.
+#[derive(Debug, Default)]
+pub(crate) struct ObserverState {
+    pub hooks: Option<ObserverHooks>,
+    /// `init` results by function identity.
+    pub seen: HashMap<usize, bool>,
+    /// A hook is running (its own calls are not observed).
+    pub in_hook: bool,
+    /// The exception unwinding the frame being ended.
+    pub exception: Option<Obj>,
+    /// `call_builtin` leaves the native frame to its observer wrapper.
+    pub keep_builtin_frame: bool,
+}
+
+/// The identity of a frame's function for the `init` cache.
+fn frame_key(f: &Frame) -> usize {
+    match &f.func {
+        Some(Func::User(u)) => Rc::as_ptr(u) as usize,
+        Some(Func::Builtin(b)) => Rc::as_ptr(b) as usize,
+        None => Rc::as_ptr(&f.code) as usize,
+    }
+}
+
+/// Native frames php-src does not have: the generator destructor runs as
+/// a `Generator::__destruct` method here (a `dtor_obj` handler there).
+fn is_hidden(f: &Frame) -> bool {
+    f.kind == FrameKind::Builtin
+        && f.scope
+            .as_ref()
+            .is_some_and(|c| c.lc_name.as_bytes() == b"generator")
+        && f.func
+            .as_ref()
+            .is_some_and(|func| func.name().eq_ignore_ascii_case(b"__destruct"))
+}
+
+/// The observer's view of `f`.
+pub(crate) fn observed_frame(f: &Frame) -> ObservedFrame {
+    match (&f.func, f.kind) {
+        (Some(func), FrameKind::Function | FrameKind::Builtin) => ObservedFrame {
+            function: Some(func.name().clone()),
+            scope: f.scope.as_ref().map(|c| c.name.clone()),
+            filename: None,
+            internal: matches!(func, Func::Builtin(_)),
+        },
+        _ => ObservedFrame {
+            function: None,
+            scope: None,
+            filename: Some(f.code.filename.clone()),
+            internal: false,
+        },
+    }
+}
+
+impl Vm {
+    /// Installs observer hooks (`zend_observer_fcall_register`,
+    /// `zend_execute_internal`); call from module startup.
+    pub fn set_observer(&mut self, hooks: ObserverHooks) {
+        self.observer.hooks = Some(hooks);
+    }
+
+    /// The exception unwinding the frame an `end` hook reports
+    /// (`EG(exception)`).
+    pub fn current_exception(&self) -> Option<Obj> {
+        self.observer.exception.clone()
+    }
+
+    #[inline]
+    pub(crate) fn observing(&self) -> bool {
+        self.observer.hooks.is_some() && !self.observer.in_hook
+    }
+
+    /// Runs `init` (first call only) and `begin` for the frame on top of
+    /// the stack (`zend_observer_fcall_begin`).
+    pub(crate) fn observer_begin_top(&mut self) {
+        if !self.observing() {
+            return;
+        }
+        let Some(hooks) = self.observer.hooks else {
+            return;
+        };
+        let Some(top) = self.frames.last() else {
+            return;
+        };
+        if top.kind == FrameKind::ConstExpr || is_hidden(top) {
+            return;
+        }
+        let key = frame_key(top);
+        let info = observed_frame(top);
+        self.observer.in_hook = true;
+        let observe = match self.observer.seen.get(&key) {
+            Some(&o) => o,
+            None => {
+                let o = hooks.init.is_some_and(|f| f(self, &info));
+                self.observer.seen.insert(key, o);
+                o
+            }
+        };
+        if observe {
+            if let Some(b) = hooks.begin {
+                b(self, &info);
+            }
+        }
+        self.observer.in_hook = false;
+        if observe {
+            if let Some(top) = self.frames.last_mut() {
+                top.observed = true;
+            }
+        }
+    }
+
+    /// Runs `end` for an observed frame (`zend_observer_fcall_end`).
+    pub(crate) fn observer_end(
+        &mut self,
+        info: &ObservedFrame,
+        retval: Option<&Value>,
+        exception: Option<&Obj>,
+    ) {
+        let Some(hooks) = self.observer.hooks else {
+            return;
+        };
+        let Some(e) = hooks.end else {
+            return;
+        };
+        let saved_hook = std::mem::replace(&mut self.observer.in_hook, true);
+        let saved_exc = std::mem::replace(&mut self.observer.exception, exception.cloned());
+        e(self, info, retval);
+        self.observer.exception = saved_exc;
+        self.observer.in_hook = saved_hook;
+    }
+
+    /// Ends the observed frame at `idx` (still on the stack).
+    pub(crate) fn observer_end_frame(
+        &mut self,
+        idx: usize,
+        retval: Option<&Value>,
+        exception: Option<&Obj>,
+    ) {
+        let Some(f) = self.frames.get_mut(idx) else {
+            return;
+        };
+        if !f.observed {
+            return;
+        }
+        f.observed = false;
+        let info = observed_frame(f);
+        self.observer_end(&info, retval, exception);
+    }
+
+    /// Ends every observed frame at or above `base`, innermost first
+    /// (bailout / `exit`: `zend_observer_fcall_end_all`).
+    pub(crate) fn observer_end_all(&mut self, base: usize) {
+        if self.observer.hooks.is_none() {
+            return;
+        }
+        for i in (base..self.frames.len()).rev() {
+            self.observer_end_frame(i, None, None);
+        }
+    }
+
+    /// `zend_execute_internal` enter/leave around a native body.
+    pub(crate) fn observer_internal(&mut self, leave: Option<Result<&Value, &Throw>>) {
+        let Some(hooks) = self.observer.hooks else {
+            return;
+        };
+        if self.observer.in_hook {
+            return;
+        }
+        let Some(top) = self.frames.last() else {
+            return;
+        };
+        let info = observed_frame(top);
+        self.observer.in_hook = true;
+        match leave {
+            None => {
+                if let Some(f) = hooks.internal_enter {
+                    f(self, &info);
+                }
+            }
+            Some(r) => {
+                if let Some(f) = hooks.internal_leave {
+                    let (v, exc) = match r {
+                        Ok(v) => (Some(v), None),
+                        Err(Throw::Exception(e)) => (None, Some(e.clone())),
+                        Err(_) => (None, None),
+                    };
+                    let saved = std::mem::replace(&mut self.observer.exception, exc);
+                    f(self, &info, v);
+                    self.observer.exception = saved;
+                }
+            }
+        }
+        self.observer.in_hook = false;
+    }
+
+    /// Whether `uf` creates a generator (observed on resumption instead).
+    pub(crate) fn observer_skips(flags_: u32) -> bool {
+        flags_ & flags::GENERATOR != 0
+    }
+}

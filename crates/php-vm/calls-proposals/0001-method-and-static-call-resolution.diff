+/// A function found by `zend_std_get_static_method`: a method, or the
+/// `__call`/`__callStatic` handler behind a trampoline for `magic`.
+struct StaticFbc {
+    method: Rc<Method>,
+    magic: Option<ZStr>,
+}
+
+impl StaticFbc {
+    /// `fbc->common.function_name`.
+    fn name(&self) -> String {
+        match &self.magic {
+            Some(n) => n.to_string_lossy(),
+            None => self.method.name.to_string_lossy(),
+        }
+    }
+
+    fn into_call(self, this: Option<Obj>, called: Rc<Class>) -> PendingCall {
+        PendingCall {
+            this,
+            scope: Some(self.method.scope()),
+            called: Some(called),
+            magic_name: self.magic,
+            ..PendingCall::new(self.method.func.clone())
+        }
+    }
+}

+/// The function name of a `__call`/`__callStatic` trampoline: the called
+/// name up to the first NUL byte (`zend_get_call_trampoline_func`, see
+/// `Zend/tests/magic_methods/bug46238.phpt`).
+fn trampoline_name(name: &ZStr) -> ZStr {
+    match name.as_bytes().iter().position(|&b| b == 0) {
+        Some(p) => ZStr::from(&name.as_bytes()[..p]),
+        None => name.clone(),
+    }
+}

+/// Builtins flagged `ZEND_ACC2_FORBID_DYN_CALLS`: they read or write the
+/// caller's symbol table or arguments.
+const FORBID_DYN_CALLS: [&[u8]; 6] = [
+    b"extract",
+    b"compact",
+    b"get_defined_vars",
+    b"func_get_args",
+    b"func_get_arg",
+    b"func_num_args",
+];
+
+/// `zend_forbid_dynamic_call()` for `$f()`: a dynamic call of a builtin
+/// that inspects its caller runs a stand-in that throws `Cannot call %s()
+/// dynamically` once its arguments have been parsed.
+fn forbid_dynamic_call(call: &mut PendingCall) {
+    let Func::Builtin(b) = &call.func else {
+        return;
+    };
+    if !FORBID_DYN_CALLS
+        .iter()
+        .any(|n| b.name.eq_ignore_ascii_case(n))
+    {
+        return;
+    }
+    call.func = Func::Builtin(Rc::new(Builtin {
+        name: b.name.clone(),
+        params: b.params.clone(),
+        defaults: b.defaults.clone(),
+        required: b.required,
+        return_type: b.return_type.clone(),
+        flags: b.flags,
+        handler: dynamic_call_forbidden,
+    }));
+}
+
+fn dynamic_call_forbidden(vm: &mut Vm, a: &mut Args) -> VmResult<Value> {
+    Err(vm.make_throw(
+        "Error",
+        &format!("Cannot call {}() dynamically", a.func_name()),
+    ))
+}

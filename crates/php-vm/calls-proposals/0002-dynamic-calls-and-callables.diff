+    /// `zend_is_callable_ex` rules (`"parent::m"`, `["A", "parent::m"]`,
+    /// `$this` for non-static `["A", "m"]`). Deprecations were already
+    /// raised by the callable argument check, so they are suppressed here.
+    pub(crate) fn resolve_callable_value(&mut self, callee: &Value) -> VmResult<PendingCall> {
+        if let Value::Object(o) = callee {
+            if let Some(c) = self.closure_call(o) {
+                return Ok(c);

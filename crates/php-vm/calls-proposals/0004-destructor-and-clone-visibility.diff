+    /// `zend_get_executed_scope`: the scope of the innermost user function
+    /// or method (internal functions only count when they are methods).
+    pub(crate) fn executed_scope(&self) -> Option<Rc<crate::class::Class>> {
+        self.frames
+            .iter()
+            .rev()
+            .find(|f| f.kind != crate::vm::FrameKind::Builtin || f.scope.is_some())
+            .and_then(|f| f.scope.clone())
+    }
+
     /// The current class scope.

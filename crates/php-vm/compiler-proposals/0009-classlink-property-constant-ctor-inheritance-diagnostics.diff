+/// The `Access level to %s::$%s must be %s (as in class %s)%s` error when a
+/// redeclared property narrows the parent's visibility.
+fn weaker_property_access(
+    class: &ZStr,
+    prop: &ZStr,
+    child: u32,
+    parent: u32,
+    parent_class: &ZStr,
+) -> Option<String> {
+    let weaker = match parent & flags::VISIBILITY {
+        flags::PUBLIC => child & flags::VISIBILITY != flags::PUBLIC,
+        flags::PROTECTED => child & flags::PRIVATE != 0,
+        _ => false,
+    };
+    weaker.then(|| {
+        format!(
+            "Access level to {}::${} must be {} (as in class {}){}",
+            class,
+            prop,
+            visibility_name(parent),
+            object::display_name(parent_class),
+            if parent & flags::PROTECTED != 0 {
+                " or weaker"
+            } else {
+                ""
+            }
+        )
+    })
+}

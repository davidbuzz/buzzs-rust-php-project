["echo", "progress callback"]
["new", "z"]
["call", "z", "open", "{DIR}/p.zip", 1]
["call", "z", "registerProgressCallback", 0.5, "cb:progress"]
["call", "z", "addFromString", "foo", "entry #1"]
["call", "z", "close"]
["call", "z", "open", "{DIR}/p2.zip", 9]
["call", "z", "registerProgressCallback", 0.5, "cb:progress_all"]
["call", "z", "addFromString", "foo", "entry #1"]
["call", "z", "close"]
["echo", "progress callback with nothing to write"]
["call", "z", "open", "{DIR}/p2.zip"]
["call", "z", "registerProgressCallback", 0.5, "cb:progress_all"]
["call", "z", "close"]
["echo", "cancel callback"]
["call", "z", "open", "{DIR}/c.zip", 1]
["call", "z", "registerCancelCallback", "cb:cancel:-1"]
["call", "z", "addFromString", "entry", "entry #1"]
["call", "z", "close"]
["prop", "z", "status"]
["call", "z", "getStatusString"]
["exists", "c.zip"]
["call", "z", "open", "{DIR}/c2.zip", 1]
["call", "z", "registerCancelCallback", "cb:cancel:0"]
["call", "z", "addFromString", "entry", "entry #1"]
["call", "z", "close"]

["call", "z", "close"]
["call", "z", "open", "{DIR}/b.odt"]
["entries", "z"]
["call", "z", "statName", "content.xml"]
["call", "z", "close"]
["echo", "bug40228-mb: extract from a multibyte-named archive"]
["call", "z", "open", "{FIX}/bug40228私はガラスを食べられます.zip", 1]
["call", "z", "extractTo", "{DIR}/mb"]
["ls", "mb"]
["call", "z", "close"]
["echo", "bug47667: OVERWRITE truncates"]
["call", "z", "open", "{DIR}/o.zip", 1]
["call", "z", "addFromString", "foo.txt", "foo bar foobar"]
["call", "z", "close"]
["call", "z", "open", "{DIR}/o.zip", 8]
["call", "z", "addFromString", "foo_0.txt", "foo bar foobar"]
["call", "z", "close"]
["call", "z", "open", "{DIR}/o.zip", 8]
["call", "z", "addFromString", "foo_1.txt", "foo bar foobar"]
["call", "z", "close"]
["call", "z", "open", "{DIR}/o.zip", 1]
["prop", "z", "numFiles"]
["entries", "z"]
["call", "z", "close"]
["echo", "bug64342: adding a missing file does not break close"]
["call", "z", "open", "{DIR}/m.zip", 1]
["call", "z", "addFile", "{DIR}/does-not-exist.txt"]
["call", "z", "close"]
["echo", "bug77978: colons and nested dirs in names"]
["call", "z", "open", "{DIR}/c.zip", 9]
["call", "z", "addFromString", "dir/test:/filename.txt", "contents"]
["call", "z", "close"]
["call", "z", "open", "{DIR}/c.zip"]
["call", "z", "extractTo", "{DIR}/colon", "dir/test:/filename.txt"]
["ls", "colon"]
["call", "z", "close"]
["echo", "bug8700 / bug50678: extraction times and status after close"]
["call", "z", "open", "{FIX}/bug8009.zip"]

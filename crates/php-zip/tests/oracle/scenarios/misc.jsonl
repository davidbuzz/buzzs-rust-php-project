["call", "z", "open", "{DIR}/empty53885.zip"]
["call", "z", "locateName", "a", 8]
["call", "z", "statName", "a", 8]
["call", "z", "close"]
["echo", "large-ish archive"]
["call", "z", "open", "{DIR}/big.zip", 9]

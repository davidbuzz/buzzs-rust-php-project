["call", "z", "close"]
["call", "z", "open", "{DIR}/big.zip", 4]
["call", "z", "statIndex", 0]
["call", "z", "statIndex", 1]
["call", "z", "statIndex", 2]
["call", "z", "getFromName", "a.txt", 20]

+/// [`light_run`]: no light frame was made (nothing changed).
+pub(super) const LIGHT_NONE: usize = usize::MAX;
+/// [`light_run`]: the light frame became the real frame on top, which the
+/// frame loop takes up from its resume point.
+const LIGHT_FRAME: usize = usize::MAX - 1;
+
+/// The planned call of site `site` of `code` (the current frame's) made on
+/// a light frame (`calls::light_call`) and run to its return on a core of
+/// its own, which takes the callee's slots at fixed offsets of the VM's
+/// light slot block: no frame is readied, pushed, released or popped.
+/// Returns the caller's op after the call (its resume point, stored),
+/// [`LIGHT_FRAME`] when the callee stopped at something a light frame
+/// cannot run and its real frame was made (`calls::light_materialize`),
+/// or [`LIGHT_NONE`] when the call is not one for a light frame.
+///
+/// Called by `calls::call_plain`, which reports the call as entered: the
+/// tape then takes up the current frame (the caller, at its stored resume
+/// point after the call, or the real frame made). Out of line, with its own
+/// copy of [`run_core`]: [`run_tape`] is not changed at all (a test of the
+/// light call in its loop cost every other planned call ~20 instructions
+/// of register shuffling).
+///
+/// # Safety
+/// No light frame is running (they never nest: a leaf makes no call).
+#[inline(never)]
+pub(super) unsafe fn light_run(vm: &mut Vm, code: &OpArray, site: usize) -> usize {
+    if crate::interrupt::safe_point_due() {
+        return LIGHT_NONE;
+    }
+    let slots: *mut Value = vm.light_slots.as_mut_ptr().cast();
+    // SAFETY: the slots are free.
+    let Some(lp) = (unsafe { calls::light_call(vm, code, site, slots) }) else {
+        return LIGHT_NONE;
+    };
+    // SAFETY: the plan lives with the caller's op array.
+    let plan: &calls::Plan = unsafe { &*lp };
+    let (lcode, ltape, lits, ncv, _) = plan.leaf_parts();
+    let Some(f) = vm.frames.last_mut() else {
+        return LIGHT_NONE;
+    };
+    let st = St {
+        cvs: slots.cast(),
+        // SAFETY: within the light slots (`ncv + ntmp` fit).
+        tmps: unsafe { slots.add(ncv as usize) }.cast(),
+        lits,
+        // (Not read by the instructions a leaf has: `leaf_safe`.)
+        f: std::ptr::from_mut(f),
+    };
+    // SAFETY: the callee's tape, from its first op; the light slots are
+    // sized for its code.
+    let out = unsafe { run_core::<false>(st, std::ptr::null(), ltape.add(plan.first_op())) };
+    // SAFETY: both point into the callee's tape.
+    #[allow(clippy::cast_sign_loss)]
+    let at = unsafe { out.ip.offset_from(ltape) } as usize;
+    // SAFETY: the callee's op array, held by its function.
+    let lc: &OpArray = unsafe { &*lcode };
+    if out.why == WHY_EXIT {
+        if let Some(&Op::Return { val }) = lc.ops.get(at) {
+            // SAFETY: the light frame's slots.
+            if unsafe { calls::light_return(vm, plan, slots, val) } {
+                return plan.done();
+            }
+        }
+    }
+    // SAFETY: as above.
+    unsafe { calls::light_materialize(vm, plan, slots, at) };
+    LIGHT_FRAME
+}
+
+/// Whether the instruction `inst` of op `op` may run on a light frame
+/// (`calls::light_call`): it needs neither the frame (`St::f`) nor the VM,
+/// and runs no user code: the numeric core instructions, jumps, and the
+/// return.
+pub(super) fn leaf_safe(inst: &Inst, op: &Op) -> bool {
+    match inst.op {
+        TOp::Exit => matches!(op, Op::Return { .. }),
+        TOp::Jmp
+        | TOp::JmpZT
+        | TOp::JmpNzT
+        | TOp::IncC
+        | TOp::DecC
+        | TOp::PreIncT
+        | TOp::PreDecT
+        | TOp::PostIncT
+        | TOp::PostDecT => true,
+        o => o.jit_meta().is_some(),
+    }
+}

+/// The slots of the light frame ([`light_call`]): `run_tape`'s own buffer.
+pub(crate) const LIGHT_SLOTS: usize = 64;
+
+impl Plan {
+    /// A leaf callee's op array, tape, literals, and numbers of compiled
+    /// variables and temporaries ([`light_call`]).
+    #[inline(always)]
+    #[allow(clippy::inline_always)] // a few loads
+    pub(super) fn leaf_parts(&self) -> (*const OpArray, *const super::Inst, *const u8, u32, u32) {
+        self.leaf_at.get()
+    }
+
+    /// The callee's first op (after the `RECV`s of the passed arguments).
+    pub(super) fn first_op(&self) -> usize {
+        self.first_op
+    }
+
+    /// The caller's op after the call.
+    pub(super) fn done(&self) -> usize {
+        self.done
+    }
+}
+
+/// Whether the callee of `plan` is a leaf: its tape from the first op on
+/// has only instructions that need neither the frame nor the VM (the
+/// numeric core instructions, jumps) and returns, so that it can run on a
+/// light frame from its call to its return. Worked out once.
+#[cold]
+#[inline(never)]
+fn leaf_of(plan: &Plan) -> bool {
+    let ok = (|| {
+        let uf = plan.uf.upgrade()?;
+        let code: &OpArray = &uf.code;
+        let tape = code.tape.get(code);
+        if !code
+            .tape
+            .jit_cnt
+            .load(std::sync::atomic::Ordering::Relaxed)
+            .is_null()
+            || code.cv_names.len() + code.num_tmps as usize > LIGHT_SLOTS
+            || uf.return_type.is_some()
+            || code.num_iters != 0
+            || code.num_finally != 0
+        {
+            return None;
+        }
+        for i in plan.first_op..code.ops.len() {
+            if !super::leaf_safe(tape.get(i)?, code.ops.get(i)?) {
+                return None;
+            }
+        }
+        #[allow(clippy::cast_possible_truncation)] // at most `LIGHT_SLOTS`
+        plan.leaf_at.set((
+            std::ptr::from_ref(code),
+            tape.as_ptr(),
+            code.literals.as_ptr().cast(),
+            code.cv_names.len() as u32,
+            code.num_tmps,
+        ));
+        Some(())
+    })()
+    .is_some();
+    plan.leaf.set(if ok { 1 } else { 2 });
+    ok
+}
+
+/// The planned call of the site at `at` of `code` (the current frame's)
+/// made on a light frame: the callee's compiled variables and temporaries
+/// in `slots` (`run_tape`'s buffer: variables first, then temporaries), its
+/// arguments copied or moved there, and nothing else readied, pushed or
+/// written but the caller's resume point. A plain function whose body is a
+/// leaf ([`leaf_of`]) only. `None`, nothing changed, for any other call.
+///
+/// # Safety
+/// `slots` points to [`LIGHT_SLOTS`] writable slots not in use.
+#[inline(never)]
+pub(super) unsafe fn light_call(
+    vm: &mut Vm,
+    code: &OpArray,
+    site: usize,
+    slots: *mut Value,
+) -> Option<*const Plan> {
+    let plan: &Plan = plan_slot(code, site)?.get()?.as_deref()?;
+    if !matches!(plan.kind, PlanKind::Function)
+        || plan.typed
+        || plan.defaults
+        || plan.fetches
+        || plan.bound != plan.n
+    {
+        plan.leaf.set(2);
+        return None;
+    }
+    if vm.observer.enabled {
+        return None;
+    }
+    match plan.leaf.get() {
+        1 => {}
+        0 if leaf_of(plan) => {}
+        _ => return None,
+    }
+    let caller = vm.frames.last_mut()?;
+    let n = plan.n as usize;
+    for i in 0..n {
+        let ok = match plan.kinds[i] {
+            PLAN_CV => matches!(
+                caller.cvs.get(plan.idx[i] as usize).and_then(crate::vm::CvSlot::get),
+                Some(v) if !matches!(v, Value::Reference(_))
+            ),
+            PLAN_TMP => matches!(
+                caller.tmps.get(plan.idx[i] as usize),
+                Some(v) if !matches!(v, Value::Reference(_))
+            ),
+            _ => code.literals.get(plan.idx[i] as usize).is_some(),
+        };
+        if !ok {
+            return None;
+        }
+    }
+    let (_, _, _, ncv, ntmp) = plan.leaf_at.get();
+    let (ncv_u, ntmp_u) = (ncv as usize, ntmp as usize);
+    // SAFETY: `ncv + ntmp <= LIGHT_SLOTS` (`leaf_of`); the slots are free:
+    // each is initialised here. A compiled variable is an `Option<Value>`
+    // of the same size (`CvSlot`), undefined.
+    unsafe {
+        let cvs = slots.cast::<Option<Value>>();
+        for i in 0..ncv_u {
+            std::ptr::write(cvs.add(i), None);
+        }
+        for i in 0..ntmp_u {
+            std::ptr::write(slots.add(ncv_u + i), Value::Null);
+        }
+        for i in 0..n.min(ncv_u) {
+            let idx = plan.idx[i] as usize;
+            let v = match plan.kinds[i] {
+                PLAN_CV => caller
+                    .cvs
+                    .get(idx)
+                    .and_then(crate::vm::CvSlot::get)
+                    .map_or(Value::Null, clone_value),
+                PLAN_TMP => caller
+                    .tmps
+                    .get_mut(idx)
+                    .map(std::mem::take)
+                    .unwrap_or_default(),
+                _ => code.literals.get(idx).map_or(Value::Null, clone_value),
+            };
+            std::ptr::write(cvs.add(i), Some(v));
+        }
+    }
+    caller.ip = plan.done;
+    Some(std::ptr::from_ref(plan))
+}

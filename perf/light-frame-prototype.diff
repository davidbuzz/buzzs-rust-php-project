+/// The return of the light frame `l` (`Op::Return` of `val`): the value
+/// moved into the caller's result slot, the light slots released.
+/// `false`, nothing changed, when that needs a real frame (an undefined
+/// variable returned, a result slot or a slot whose release may run user
+/// code): [`light_materialize`] then.
+///
+/// # Safety
+/// `slots` holds the light frame of `l`.
+#[inline(never)]
+pub(super) unsafe fn light_return(
+    vm: &mut Vm,
+    plan: &Plan,
+    slots: *mut Value,
+    val: Operand,
+) -> bool {
+    let (_, _, lits, ncv, ntmp) = plan.leaf_at.get();
+    let (ncv, ntmp) = (ncv as usize, ntmp as usize);
+    // SAFETY: the light frame's slots (see `light_call`).
+    let (cvs, tmps) = unsafe {
+        (
+            std::slice::from_raw_parts_mut(slots.cast::<Option<Value>>(), ncv),
+            std::slice::from_raw_parts_mut(slots.add(ncv), ntmp),
+        )
+    };
+    let Some(caller) = vm.frames.last_mut() else {
+        return false;
+    };
+    // Releasing what is left must run no user code: scalars and strings.
+    let plain = |v: &Value| {
+        matches!(
+            v,
+            Value::Null | Value::Bool(_) | Value::Int(_) | Value::Float(_) | Value::Str(_)
+        )
+    };
+    let dst = match plan.dst {
+        Some(t) => match caller.tmps.get(t as usize) {
+            Some(Value::Null | Value::Bool(_) | Value::Int(_) | Value::Float(_)) => Some(t),
+            _ => return false,
+        },
+        None => None,
+    };
+    let v = match val {
+        Operand::Tmp(t) => match tmps.get(t as usize) {
+            Some(v) if plain(v) || dst.is_some() => (t as usize, true),
+            _ => return false,
+        },
+        Operand::Cv(c) => match cvs.get(c as usize) {
+            Some(Some(v)) if plain(v) || dst.is_some() => (c as usize, false),
+            _ => return false,
+        },
+        Operand::Lit(_) | Operand::Unused => (usize::MAX, false),
+        Operand::TmpKeep(_) => return false,
+    };
+    // Every other slot must release without user code.
+    for (i, c) in cvs.iter().enumerate() {
+        if !(v == (i, false) || c.as_ref().is_none_or(|x| plain(x))) {
+            return false;
+        }
+    }
+    for (i, t) in tmps.iter().enumerate() {
+        if !(v == (i, true) || plain(t)) {
+            return false;
+        }
+    }
+    let result = match val {
+        Operand::Tmp(t) => std::mem::take(&mut tmps[t as usize]),
+        Operand::Cv(c) => cvs[c as usize].take().unwrap_or_default(),
+        Operand::Lit(i) => {
+            // SAFETY: the callee's literals (`Light::lits`), index from its op.
+            unsafe { clone_value(&*lits.cast::<Value>().add(i as usize)) }
+        }
+        _ => Value::Null,
+    };
+    // (Scalars own nothing; only strings are released.)
+    for c in cvs.iter_mut() {
+        if let Some(Value::Str(_)) = c {
+            drop(c.take());
+        }
+    }
+    for t in tmps.iter_mut() {
+        if let Value::Str(_) = t {
+            drop(std::mem::take(t));
+        }
+    }
+    match dst.and_then(|t| caller.tmps.get_mut(t as usize)) {
+        Some(d) => std::mem::forget(std::mem::replace(d, result)),
+        None => drop(result),
+    }
+    true
+}
+
+/// Turns the light frame `l` into the real frame its call would have
+/// pushed (`call_planned`'s), its slots moved there, resuming at the
+/// callee's op `ip`: for anything the light frame cannot run.
+///
+/// # Safety
+/// `slots` holds the light frame of `l`; afterwards it holds nothing.
+#[inline(never)]
+pub(super) unsafe fn light_materialize(vm: &mut Vm, plan: &Plan, slots: *mut Value, ip: usize) {
+    let (_, _, _, ncv, ntmp) = plan.leaf_at.get();
+    let (ncv, ntmp) = (ncv as usize, ntmp as usize);
+    let live = vm.frames.live;
+    vm.frames.ensure_pooled(&vm.empty_code, &vm.empty_vars);
+    let strict = vm.frames.last().is_some_and(|f| f.code.strict_types);
+    let Some(frame) = vm.frames.vec.get_mut(live) else {
+        return;
+    };
+    if frame.released_direct
+        && frame
+            .ufunc
+            .as_ref()
+            .is_some_and(|f| Rc::as_ptr(f) as usize == plan.uf_addr)
+    {
+        frame.released_direct = false;
+    } else if let Some(uf) = plan.uf.upgrade() {
+        ready_frame_slow(frame, &uf);
+    }
+    // SAFETY: the light frame's slots, each moved out once.
+    unsafe {
+        let cvs = slots.cast::<Option<Value>>();
+        for i in 0..ncv {
+            let v = std::ptr::read(cvs.add(i));
+            match frame.cvs.get_mut(i) {
+                Some(slot) => drop(slot.set(v)),
+                None => drop(v),
+            }
+        }
+        for i in 0..ntmp {
+            let v = std::ptr::read(slots.add(ncv + i));
+            match frame.tmps.get_mut(i) {
+                Some(t) => drop(std::mem::replace(t, v)),
+                None => drop(v),
+            }
+        }
+    }
+    frame.ret = plan.dst.map_or(RetTarget::Discard, RetTarget::Tmp);
+    frame.caller_strict = strict;
+    frame.direct_argc = u32::from(plan.n);
+    frame.ip = ip;
+    frame.direct = true;
+    frame.plain = true;
+    vm.frames.live = live + 1;
+}
